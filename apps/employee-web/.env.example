# API Gateway Endpoint (leave empty for default Vite proxy in development)
VITE_API_URL=

# Mock UI Control
# Set VITE_ENABLE_MOCK=false to hide persona helper buttons and SSO simulation banner for production
VITE_ENABLE_MOCK=true

# Admin Portal URL (redirect target for "สำหรับผู้ดูแลระบบ" button)
VITE_ADMIN_URL=https://mental-health-admin.onrender.com/

PORT=4000
NODE_ENV=development
SERVICE_ROLE=all

# Database Configuration
# Leave MONGODB_URI empty to run with local simulated file store (.data/)
# Provide MongoDB URI for real database in production
MONGODB_URI=
MONGODB_DB_NAME=mental_health_assessment

# Mock Data Control
# Set SEED_MOCK=false to disable automatic mock employee seeding and start with a clean database
SEED_MOCK=true

# Security & Assessment Config
DRAFT_TTL_MINUTES=15
PII_ENCRYPTION_KEY=mental-health-pii-secret-key-32ch
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=Admin@123456!
SUPERADMIN_DEFAULT_USER=superadmin
SUPERADMIN_DEFAULT_PASSWORD=SuperAdmin@123456!

# ============================================================
# Employee Well-being Survey - Global Environment Reference
# ============================================================

# Backend API Configuration
PORT=4000
NODE_ENV=development
SERVICE_ROLE=all

# Database Configuration
# - Leave MONGODB_URI empty to run with local simulated file store (.data/)
# - For production, provide real MongoDB connection string:
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/employee_wellbeing?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=mental_health_assessment

# Mock Data Control
# - Set SEED_MOCK=true for development/testing/demo (seeds 10 mock employees)
# - Set SEED_MOCK=false for production go-live (cleans and disables all mock data)
SEED_MOCK=true

# Assessment & Security
DRAFT_TTL_MINUTES=15
PII_ENCRYPTION_KEY=mental-health-pii-secret-key-32ch

# Frontend Apps (Admin Web & Employee Web)
# - Set VITE_ENABLE_MOCK=true to show persona selectors, SSO simulator banner, and seed mock buttons
# - Set VITE_ENABLE_MOCK=false to hide all mock UI and prototype badges for production
VITE_ENABLE_MOCK=true
VITE_API_URL=
VITE_ADMIN_URL=https://mental-health-admin.onrender.com/
VITE_EMPLOYEE_URL=https://employee-well-being-survey.onrender.com/
